<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FocusOS | Intelligent Workspace</title>
<style>
    :root {
        /* Ultra Modern Palette */
        --bg-color: #050505;
        --glass-panel: rgba(22, 22, 24, 0.9);
        --glass-border: rgba(255, 255, 255, 0.1);
        --sidebar-bg: rgba(10, 10, 12, 0.98);
        --accent: #6c5ce7; 
        --accent-hover: #5649c0;
        --text-primary: #ffffff;
        --text-muted: #a0a0a0;
        --danger: #ff4757;
        --success: #2ed573;
        
        --radius-xl: 24px;
        --radius-m: 14px;
        --font-main: 'Inter', system-ui, -apple-system, sans-serif;
    }

    * { box-sizing: border-box; }

    body {
        margin: 0; height: 100vh;
        background-color: var(--bg-color);
        color: var(--text-primary);
        font-family: var(--font-main);
        overflow: hidden;
        display: flex; justify-content: center; align-items: center;
        background: radial-gradient(circle at 10% 20%, rgba(108, 92, 231, 0.15), transparent 40%),
                    radial-gradient(circle at 90% 80%, rgba(46, 213, 115, 0.08), transparent 40%);
    }

    /* --- LAYOUT --- */
    #app-container {
        display: none; /* Hidden until setup is done */
        width: 98vw; height: 96vh;
        background: var(--glass-panel);
        border: 1px solid var(--glass-border);
        border-radius: var(--radius-xl);
        box-shadow: 0 50px 100px rgba(0,0,0,0.8);
        overflow: hidden;
        backdrop-filter: blur(40px);
        display: flex; /* Flex required for layout, but hidden via JS initially */
    }

    /* SIDEBAR */
    .sidebar {
        width: 260px;
        background: var(--sidebar-bg);
        border-right: 1px solid var(--glass-border);
        display: flex; flex-direction: column;
        padding: 30px 15px;
        z-index: 20; /* High z-index to stay clickable */
    }
    
    .logo-area { font-weight: 800; font-size: 1.4rem; margin-bottom: 30px; padding-left: 10px; color: white; letter-spacing: -0.5px; }
    
    .nav-header { padding: 0 12px; font-size: 0.7rem; font-weight: 700; color: var(--text-muted); margin: 20px 0 8px 0; text-transform: uppercase; letter-spacing: 1.2px; }

    .nav-item {
        padding: 12px 16px; margin-bottom: 4px; border-radius: 12px;
        cursor: pointer; color: var(--text-muted); font-size: 0.95rem; font-weight: 500;
        display: flex; align-items: center; gap: 12px; transition: 0.2s;
    }
    .nav-item:hover { background: rgba(255,255,255,0.08); color: white; }
    .nav-item.active { background: rgba(108, 92, 231, 0.15); color: var(--accent); font-weight: 600; }

    .bottom-actions { margin-top: auto; display: flex; gap: 10px; }
    .icon-btn { 
        background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); color: #ccc;
        width: 40px; height: 40px; border-radius: 10px; cursor: pointer; transition: 0.2s;
        display: flex; justify-content: center; align-items: center; font-size: 1.1rem;
    }
    .icon-btn:hover { background: white; color: black; }

    /* WORKSPACE */
    .workspace {
        flex: 1; display: flex; flex-direction: column; position: relative;
        background: radial-gradient(circle at 50% 50%, rgba(255,255,255,0.01), transparent);
        z-index: 1;
    }

    header {
        height: 70px; border-bottom: 1px solid var(--glass-border);
        display: flex; align-items: center; justify-content: space-between; padding: 0 32px;
    }

    .timer-group { display: flex; align-items: center; gap: 15px; }
    .timer-pill {
        background: #000; padding: 8px 18px; border-radius: 20px; border: 1px solid var(--glass-border);
        font-variant-numeric: tabular-nums; font-size: 1.2rem; font-weight: 700; color: white;
    }
    .timer-pill.break { color: var(--success); border-color: rgba(46, 213, 115, 0.3); }

    .pill-action {
        background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 6px 14px;
        border-radius: 20px; font-size: 0.8rem; cursor: pointer; transition: 0.2s; color: var(--text-muted);
    }
    .pill-action:hover { background: var(--accent); color: white; }

    .content-area { flex: 1; padding: 40px; overflow-y: auto; position: relative; }

    /* VIDEO TAB STYLES */
    .video-stage { display: flex; flex-direction: column; gap: 20px; height: 100%; }
    .video-player-box {
        background: black; border-radius: 16px; overflow: hidden; aspect-ratio: 16/9;
        border: 1px solid var(--glass-border); position: relative;
    }
    .video-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px; margin-top: 20px;
    }
    .video-card {
        background: rgba(255,255,255,0.05); border-radius: 12px; padding: 15px; cursor: pointer;
        border: 1px solid transparent; transition: 0.2s; display: flex; flex-direction: column; gap: 10px;
    }
    .video-card:hover { background: rgba(255,255,255,0.1); border-color: var(--accent); transform: translateY(-2px); }
    .video-thumb {
        width: 100%; height: 100px; background: #222; border-radius: 8px; 
        display: flex; align-items: center; justify-content: center; font-size: 2rem;
    }
    .video-title { font-size: 0.9rem; font-weight: 600; color: #fff; line-height: 1.4; }
    .video-meta { font-size: 0.75rem; color: var(--text-muted); }

    /* DRAWING CANVAS */
    #canvas-wrapper { position: absolute; inset: 0; background: #111; z-index: 5; display: none; cursor: crosshair; }
    .drawing-toolbar {
        position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%);
        background: var(--glass-panel); border: 1px solid var(--glass-border);
        padding: 10px 20px; border-radius: 50px; display: flex; gap: 15px; align-items: center;
    }
    .color-swatch { width: 24px; height: 24px; border-radius: 50%; cursor: pointer; border: 2px solid transparent; }
    .color-swatch.active { transform: scale(1.2); border-color: white; }

    /* QUICK AI */
    .inspector {
        width: 320px; background: var(--sidebar-bg); border-left: 1px solid var(--glass-border);
        display: flex; flex-direction: column; z-index: 20;
    }
    .chat-container { flex: 1; padding: 20px; overflow-y: auto; display: flex; flex-direction: column; gap: 15px; }
    .chat-msg { padding: 12px 18px; border-radius: 16px; font-size: 0.9rem; line-height: 1.5; max-width: 90%; word-wrap: break-word; }
    .chat-msg.bot { background: rgba(255,255,255,0.05); color: #ddd; align-self: flex-start; }
    .chat-msg.user { background: var(--accent); color: white; align-self: flex-end; }
    .input-box { padding: 20px; border-top: 1px solid var(--glass-border); position: relative; }

    /* SETTINGS BAR - FIXED CLICK ISSUE */
    #settings-overlay {
        position: absolute; top: 0; right: 0; width: 400px; height: 100%;
        background: #111; border-left: 1px solid var(--glass-border);
        z-index: 100; transform: translateX(100%); transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex; flex-direction: column; padding: 30px; box-shadow: -20px 0 50px rgba(0,0,0,0.5); overflow-y: auto;
        pointer-events: none; /* Allows clicks to pass through when hidden */
    }
    #settings-overlay.open { transform: translateX(0); pointer-events: auto; }
    .setting-section { margin-bottom: 30px; }
    .setting-title { font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 12px; font-weight: 700; }
    .setting-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }

    /* SETUP MODAL */
    #setup-overlay { position: fixed; inset:0; background: rgba(0,0,0,0.95); z-index: 5000; display:flex; justify-content:center; align-items:center; }
    .modal-box { background:#111; padding:40px; border-radius:24px; border:1px solid var(--glass-border); width:500px; text-align:center; box-shadow: 0 50px 100px rgba(0,0,0,0.8); }
    .clean-input { width: 100%; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); padding: 12px; border-radius: 12px; color: white; outline: none; margin-bottom: 15px; }
    .clean-input:focus { border-color: var(--accent); }
    
    /* GAMES */
    #break-overlay { display: none; position: fixed; inset: 0; background: rgba(5,5,5,0.98); z-index: 2000; flex-direction: column; justify-content: center; align-items: center; }
    .game-canvas { border: 2px solid var(--glass-border); border-radius: 12px; background: #000; box-shadow: 0 0 40px rgba(108, 92, 231, 0.2); }
    .game-menu { display: flex; gap: 20px; margin-bottom: 20px; }
    .game-card { background: #222; padding: 15px 25px; border-radius: 12px; cursor: pointer; border: 1px solid transparent; transition: 0.2s; text-align: center; }
    .game-card:hover { border-color: var(--accent); background: #333; }

    /* UTILS */
    .primary-btn { background: var(--accent); color: white; border: none; padding: 14px; border-radius: 12px; cursor: pointer; font-weight: 600; width: 100%; transition: 0.2s; }
    .primary-btn:hover { background: var(--accent-hover); }
    .switch { position: relative; display: inline-block; width: 46px; height: 26px; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #333; transition: .4s; border-radius: 34px; }
    input:checked + .slider { background-color: var(--accent); }
    input:checked + .slider:before { transform: translateX(20px); content:""; position:absolute; height:20px; width:20px; left:3px; bottom:3px; background:white; border-radius:50%; transition:.4s; }
    
    .hidden { display: none !important; pointer-events: none !important; }
    .lesson-view { line-height: 1.8; color: #ddd; white-space: pre-wrap; font-size: 1.05rem; }
    textarea.clean-editor { width: 100%; height: 100%; background: transparent; border: none; outline: none; color: #eee; font-size: 1.1rem; line-height: 1.8; font-family: inherit; resize: none; }
    
    .quiz-option { background: rgba(255,255,255,0.05); padding: 15px; margin-bottom: 10px; border-radius: 8px; cursor: pointer; border: 1px solid transparent; transition: 0.2s; }
    .quiz-option:hover { background: rgba(255,255,255,0.1); }
    .quiz-option.correct { border-color: var(--success); background: rgba(46, 213, 115, 0.1); }
    .quiz-option.wrong { border-color: var(--danger); }

</style>
</head>
<body onload="initApp()">

<!-- SETUP OVERLAY (First Screen) -->
<div id="setup-overlay">
    <div class="modal-box">
        <h1 style="margin-bottom: 5px;">FocusOS</h1>
        <p style="color:#888; margin-bottom:25px;">Setup your learning environment.</p>
        
        <input type="text" id="setup-subject" class="clean-input" placeholder="Subject Name (e.g. AP Biology)">
        
        <select id="setup-level" class="clean-input" style="background:#222; cursor:pointer;">
            <option value="Elementary">Elementary School</option>
            <option value="Middle School">Middle School</option>
            <option value="High School">High School</option>
            <option value="Undergraduate" selected>College / Undergraduate</option>
            <option value="PhD">Expert / PhD</option>
        </select>
        
        <textarea id="setup-lesson" class="clean-input" style="height:120px; resize:none;" placeholder="Paste your lesson text / syllabus here to generate notes & quizzes..."></textarea>
        
        <button class="primary-btn" onclick="finishSetup()">Initialize Workspace</button>
    </div>
</div>

<!-- MAIN APPLICATION -->
<div id="app-container" class="hidden">
    
    <!-- LEFT SIDEBAR -->
    <div class="sidebar">
        <div class="logo-area">FocusOS</div>
        
        <div class="nav-header">Study</div>
        <div class="nav-item active" onclick="setMode('lesson', this)">📖 Lesson Summary</div>
        <div class="nav-item" onclick="setMode('notes', this)">📝 My Notes</div>
        <div class="nav-item" onclick="setMode('videos', this)">📺 Videos</div>
        <div class="nav-item" onclick="setMode('canvas', this)" id="nav-canvas">🎨 Whiteboard</div>
        <div class="nav-item" onclick="setMode('files', this)">📂 Files</div>
        
        <div class="nav-header">Practice</div>
        <div class="nav-item" onclick="setMode('practice', this)">✍️ Practice Test</div>
        <div class="nav-item" onclick="setMode('review', this)">🎓 Test Review</div>
        
        <div class="bottom-actions">
            <div class="icon-btn" onclick="toggleSettings()" title="Settings">⚙️</div>
            <div class="icon-btn" onclick="endSession()" title="End Session" style="color:var(--danger)">✕</div>
        </div>
    </div>

    <!-- CENTER WORKSPACE -->
    <div class="workspace">
        <header>
            <strong id="header-title">Lesson Summary</strong>
            <div class="timer-group">
                <div class="pill-action" onclick="requestPause()">⏸ Pause</div>
                <div class="pill-action" onclick="requestManualBreak()">☕ Break (<span id="breaks-left">10</span>)</div>
                <div class="timer-pill" id="timer">25:00</div>
            </div>
        </header>

        <!-- MUSIC PLAYER (Hidden until linked) -->
        <div id="spotify-container" style="display:none; padding: 20px 32px 0 32px;">
            <iframe id="spotify-frame" style="border-radius:12px" src="" width="100%" height="80" frameBorder="0" allowfullscreen="" loading="lazy"></iframe>
        </div>

        <!-- MAIN CONTENT AREA -->
        <div class="content-area" id="main-content">
            <!-- Dynamic Injection -->
        </div>

        <!-- PERSISTENT CANVAS -->
        <div id="canvas-wrapper">
            <canvas id="drawing-canvas"></canvas>
            <div class="drawing-toolbar">
                <div class="color-swatch active" style="background:#fff" onclick="setDrawColor(this, '#fff')"></div>
                <div class="color-swatch" style="background:#ff4757" onclick="setDrawColor(this, '#ff4757')"></div>
                <div class="color-swatch" style="background:#2ed573" onclick="setDrawColor(this, '#2ed573')"></div>
                <div class="color-swatch" style="background:#1e90ff" onclick="setDrawColor(this, '#1e90ff')"></div>
                <input type="range" min="1" max="20" value="3" onchange="setLineWidth(this.value)" style="width:80px; margin-left:10px;">
                <button class="pill-action" onclick="clearCanvas()" style="margin-left:10px;">Clear</button>
            </div>
        </div>
    </div>

    <!-- RIGHT SIDEBAR (AI) -->
    <div class="inspector">
        <div class="nav-header" style="padding: 20px; display:flex; justify-content:space-between; align-items:center;">
            <span>Quick AI</span>
            <div style="display:flex; gap:10px;">
                <button class="icon-btn" style="width:24px; height:24px; font-size:0.8rem;" onclick="newChat()" title="New Chat">＋</button>
                <button class="icon-btn" style="width:24px; height:24px; font-size:0.8rem;" onclick="toggleTTS()" id="tts-btn">🔇</button>
            </div>
        </div>
        <div class="chat-container" id="chat-history">
            <div class="chat-msg bot">I have analyzed your lesson material. Ask me anything.</div>
        </div>
        <div class="input-box">
            <input type="text" class="clean-input" id="ai-input" placeholder="Ask AI..." onkeypress="handleAI(event)">
            <span style="position:absolute; right:30px; top:32px; cursor:pointer;" onclick="toggleDictation()">🎙️</span>
        </div>
    </div>
</div>

<!-- SETTINGS PANEL (Hidden Right) -->
<div id="settings-overlay">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:30px;">
        <h2 style="margin:0;">Control Center</h2>
        <button class="icon-btn" onclick="toggleSettings()">→</button>
    </div>

    <div class="setting-section">
        <div class="setting-title">AI Intelligence</div>
        <input type="password" id="api-key-input" class="clean-input" placeholder="Google Gemini/OpenAI Key" onchange="saveConfig()">
        <p style="font-size:0.75rem; color:#666;">Provide key for smarter notes & quizzes.</p>
    </div>

    <div class="setting-section">
        <div class="setting-title">Audio & Alarm</div>
        <div class="setting-row">
            <span class="setting-desc">Custom Alarm</span>
            <input type="file" id="custom-alarm-upload" accept="audio/*" style="width:180px; font-size:0.8rem;">
        </div>
    </div>

    <div class="setting-section">
        <div class="setting-title">Music</div>
        <input type="text" id="spotify-link-input" class="clean-input" placeholder="Spotify Playlist URL" onchange="updateSpotify()">
    </div>
</div>

<!-- BRAIN BREAK ARCADE -->
<div id="break-overlay">
    <h1 style="margin-bottom:10px;">Brain Break</h1>
    <div id="break-timer-display" style="font-size:3rem; font-weight:700; margin-bottom:20px;">07:00</div>
    
    <div class="game-menu" id="game-menu">
        <div class="game-card" onclick="setGame('snake')">🐍 Snake</div>
        <div class="game-card" onclick="setGame('jumper')">🏃 Jumper</div>
        <div class="game-card" onclick="setGame('dots')">🟡 Dot Eater</div>
    </div>

    <canvas id="game-canvas" class="game-canvas" width="400" height="300"></canvas>
    <p style="font-size:0.8rem; color:#666; margin-top:10px;">Arrow Keys to Play | Space to Jump</p>
    
    <button class="primary-btn" style="width:auto; margin-top:20px;" onclick="endBreak()">Resume Focus</button>
</div>

<!-- LOCKOUT & PAUSE OVERLAYS -->
<div id="lockout-overlay" class="hidden">
    <div style="font-size:5rem;">🔒</div>
    <h2>Locked</h2>
    <p style="color:#aaa;">You left the tab. Answer to unlock.</p>
    <p id="lockout-q" style="font-size:1.2rem; color:white; margin:10px 0;">Question...</p>
    <input type="text" id="lockout-a" class="clean-input" style="width:300px; text-align:center;" onkeypress="checkLockout(event)">
</div>

<div id="pause-modal" class="hidden" style="position:fixed; inset:0; background:rgba(0,0,0,0.8); z-index:4000; display:flex; justify-content:center; align-items:center;">
    <div class="modal-box">
        <h2>Pause Session</h2>
        <input type="number" id="pause-duration" class="clean-input" placeholder="Minutes" style="text-align:center;">
        <button class="primary-btn" onclick="confirmPause()">Pause</button>
        <button class="primary-btn" style="background:#333; margin-top:10px;" onclick="document.getElementById('pause-modal').classList.add('hidden')">Cancel</button>
    </div>
</div>

<script>
    // --- GLOBAL STATE ---
    const state = {
        subject: "General",
        level: "Undergraduate",
        lessonRaw: "",
        summary: "",
        quizQuestions: [],
        suggestedVideos: [],
        
        mode: "lesson",
        focusTime: 25,
        seconds: 25 * 60,
        isBreak: false,
        isPaused: false,
        breaksLeft: 10,
        
        apiKey: "",
        tts: false,
        customAlarm: null,
        
        currentGame: null,
        gameInterval: null
    };

    // --- INITIALIZATION ---
    function initApp() {
        try {
            const saved = JSON.parse(localStorage.getItem('focusOS_data') || '{}');
            if(saved.subject) {
                document.getElementById('setup-subject').value = saved.subject;
                document.getElementById('setup-lesson').value = saved.lessonRaw || "";
                state.level = saved.level || "Undergraduate";
                document.getElementById('setup-level').value = state.level;
            }
            if(saved.apiKey) {
                state.apiKey = saved.apiKey;
                document.getElementById('api-key-input').value = saved.apiKey;
            }
        } catch(e) { console.log("Init Error", e); }
        
        setupCanvas();
        
        // Ensure app container is hidden initially
        document.getElementById('app-container').classList.add('hidden');
        document.getElementById('app-container').style.display = 'none';
        document.getElementById('setup-overlay').classList.remove('hidden');
    }

    function finishSetup() {
        state.subject = document.getElementById('setup-subject').value || "General";
        state.level = document.getElementById('setup-level').value;
        state.lessonRaw = document.getElementById('setup-lesson').value;

        // Save Data
        localStorage.setItem('focusOS_data', JSON.stringify({
            subject: state.subject,
            level: state.level,
            lessonRaw: state.lessonRaw,
            apiKey: state.apiKey
        }));

        // Generate Content
        generateSummary();
        generateQuiz();
        generateVideoSuggestions();

        // UI Transition: Completely hide overlay and show app
        document.getElementById('setup-overlay').style.display = 'none';
        document.getElementById('app-container').classList.remove('hidden');
        document.getElementById('app-container').style.display = 'flex';
        
        // Start Timer
        setInterval(tick, 1000);
        setMode('lesson', document.querySelector('.nav-item'));

        // Security
        document.addEventListener('visibilitychange', () => {
            if(document.hidden && !state.isBreak && !state.isPaused) triggerLockout();
        });
    }

    // --- CONTENT GENERATION ---
    function generateSummary() {
        if(state.lessonRaw.length > 30) {
            state.summary = `<h2>Lesson Summary: ${state.subject}</h2>
                             <p style="color:#aaa;">Level: ${state.level}</p>
                             <hr style="border-color:rgba(255,255,255,0.1); margin:15px 0;">
                             <ul>` + 
                             state.lessonRaw.split('.').slice(0,5).map(s => s.trim() ? `<li>${s}.</li>` : '').join('') + 
                             `</ul>`;
        } else {
            state.summary = `<h2>${state.subject}</h2><p>No lesson text provided.</p>`;
        }
    }

    function generateQuiz() {
        state.quizQuestions = [
            {q: `What is the core concept of ${state.subject}?`, a: "Fundamental Theory"},
            {q: "True or False: This is important.", a: "True"}
        ];
    }

    function generateVideoSuggestions() {
        const keywords = state.lessonRaw.split(' ').filter(w => w.length > 5).slice(0, 3);
        const core = keywords.length > 0 ? keywords : [state.subject];
        state.suggestedVideos = core.map(k => ({ title: `Learn: ${k}`, query: k.replace(/[^a-zA-Z0-9 ]/g, "") }));
    }

    // --- NAVIGATION ---
    function setMode(mode, el) {
        state.mode = mode;
        document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
        if(el) el.classList.add('active');
        document.getElementById('header-title').innerText = mode.toUpperCase().replace('-', ' ');

        const content = document.getElementById('main-content');
        const canvas = document.getElementById('canvas-wrapper');
        
        canvas.style.display = (mode === 'canvas') ? 'block' : 'none';
        content.style.display = (mode === 'canvas') ? 'none' : 'block';

        if(mode === 'lesson') content.innerHTML = `<div class="lesson-view">${state.summary}</div>`;
        else if(mode === 'practice') renderQuiz();
        else if(mode === 'notes') content.innerHTML = `<textarea class="clean-editor" placeholder="My Notes..."></textarea>`;
        else if (mode === 'videos') renderVideoTab();
        else if (mode === 'files') content.innerHTML = `<button class="primary-btn" style="width:auto;">Upload File</button>`;
        else if (mode === 'review') content.innerHTML = `<div style="text-align:center; padding-top:50px; color:#888;">Paste test notes in Chat.</div>`;
    }

    function renderQuiz() {
        const c = document.getElementById('main-content');
        let html = `<h3>Practice Quiz (${state.level})</h3>`;
        state.quizQuestions.forEach((q, i) => {
            html += `<div style="margin-bottom:20px;">
                <p><strong>Q${i+1}:</strong> ${q.q}</p>
                <div class="quiz-option" onclick="this.classList.add('correct')">${q.a}</div>
                <div class="quiz-option" onclick="this.classList.add('wrong')">Incorrect Option</div>
            </div>`;
        });
        c.innerHTML = html;
    }

    function renderVideoTab() {
        const c = document.getElementById('main-content');
        let html = `<div class="video-stage">
            <div class="video-player-box"><iframe id="main-video-embed" style="width:100%; height:100%; border:none;" src="https://www.youtube.com/embed?listType=search&list=${state.subject}+course"></iframe></div>
            <div><h3>Suggested</h3><div class="video-grid">`;
        state.suggestedVideos.forEach(v => {
            html += `<div class="video-card" onclick="window.open('https://www.youtube.com/results?search_query=${v.query}', '_blank')"><div class="video-thumb">▶</div><div class="video-title">${v.title}</div></div>`;
        });
        html += `</div></div></div>`;
        c.innerHTML = html;
    }

    // --- GAME ENGINE ---
    function setGame(gameName) {
        clearInterval(state.gameInterval);
        const cvs = document.getElementById('game-canvas');
        const ctx = cvs.getContext('2d');
        
        let px=10, py=10, ax=15, ay=15, xv=0, yv=0; // Snake
        let player={x:50, y:200, dy:0, w:20, h:20}, gravity=0.5, jump=-8; // Jumper
        let pac={x:200,y:150}, ghost={x:50,y:50}; // Dots

        if(gameName === 'snake') {
            let trail=[]; let tail=5; xv=1;
            document.onkeydown=e=>{if(e.which==37)xv=-1,yv=0;if(e.which==38)xv=0,yv=-1;if(e.which==39)xv=1,yv=0;if(e.which==40)xv=0,yv=1;};
            state.gameInterval = setInterval(() => {
                px+=xv; py+=yv;
                if(px<0)px=19; if(px>19)px=0; if(py<0)py=14; if(py>14)py=0;
                ctx.fillStyle="black"; ctx.fillRect(0,0,400,300);
                ctx.fillStyle="lime";
                for(let i=0;i<trail.length;i++) {
                    ctx.fillRect(trail[i].x*20, trail[i].y*20, 18, 18);
                    if(trail[i].x==px && trail[i].y==py) tail=5;
                }
                trail.push({x:px,y:py});
                while(trail.length>tail) trail.shift();
                if(ax==px && ay==py) { tail++; ax=Math.floor(Math.random()*20); ay=Math.floor(Math.random()*15); }
                ctx.fillStyle="red"; ctx.fillRect(ax*20, ay*20, 18, 18);
            }, 100);
        }
        else if(gameName === 'jumper') {
            let obstacles = [{x:400, y:230, w:20, h:20}];
            document.onkeydown=e=>{if(e.code==='Space'&&player.y===230) player.dy=jump;};
            state.gameInterval = setInterval(() => {
                ctx.fillStyle="#222"; ctx.fillRect(0,0,400,300);
                player.dy += gravity; player.y += player.dy;
                if(player.y > 230) { player.y=230; player.dy=0; }
                ctx.fillStyle = "cyan"; ctx.fillRect(player.x, player.y, player.w, player.h);
                ctx.fillStyle = "#555"; ctx.fillRect(0, 250, 400, 50);
                obstacles.forEach(o => {
                    o.x -= 4; ctx.fillStyle = "red"; ctx.fillRect(o.x, o.y, o.w, o.h);
                    if(o.x < -20) o.x = 400 + Math.random()*200;
                });
            }, 20);
        }
        else if(gameName === 'dots') {
            document.onkeydown=e=>{if(e.which==37)pac.x-=5;if(e.which==38)pac.y-=5;if(e.which==39)pac.x+=5;if(e.which==40)pac.y+=5;};
            state.gameInterval = setInterval(() => {
                ctx.fillStyle="black"; ctx.fillRect(0,0,400,300);
                ctx.fillStyle="yellow"; ctx.beginPath(); ctx.arc(pac.x,pac.y,10,0,Math.PI*2); ctx.fill();
                ctx.fillStyle="blue"; ctx.fillRect(ghost.x, ghost.y, 20, 20);
                if(ghost.x < pac.x) ghost.x+=2; else ghost.x-=2;
                if(ghost.y < pac.y) ghost.y+=2; else ghost.y-=2;
            }, 30);
        }
    }

    // --- CANVAS DRAWING ---
    let ctxDraw, isDraw=false;
    function setupCanvas() {
        const c = document.getElementById('drawing-canvas');
        c.width = c.parentElement.offsetWidth;
        c.height = c.parentElement.offsetHeight;
        ctxDraw = c.getContext('2d');
        c.onmousedown = e => { isDraw=true; ctxDraw.beginPath(); ctxDraw.moveTo(e.offsetX, e.offsetY); };
        c.onmousemove = e => { 
            if(isDraw) { ctxDraw.lineTo(e.offsetX, e.offsetY); ctxDraw.strokeStyle = state.drawColor || '#fff'; ctxDraw.lineWidth = state.drawWidth || 3; ctxDraw.stroke(); }
        };
        c.onmouseup = () => isDraw=false;
    }
    function setDrawColor(el, c) { state.drawColor = c; document.querySelectorAll('.color-swatch').forEach(x=>x.classList.remove('active')); el.classList.add('active'); }
    function setLineWidth(w) { state.drawWidth = w; }
    function clearCanvas() { ctxDraw.clearRect(0,0,2000,2000); }

    // --- CORE TIMERS ---
    function tick() {
        if(state.isPaused || document.getElementById('lockout-overlay').style.display === 'flex') return;
        state.seconds--;
        const m = Math.floor(state.seconds/60), s = state.seconds%60;
        document.getElementById('timer').innerText = `${m}:${s<10?'0':''}${s}`;
        document.getElementById('break-timer-display').innerText = `${m}:${s<10?'0':''}${s}`;
        
        if(state.seconds <= 0) {
            if(state.isBreak) endBreak(); else startBreak(5); 
        }
    }
    function requestManualBreak() {
        if(state.breaksLeft > 0) { state.breaksLeft--; document.getElementById('breaks-left').innerText = state.breaksLeft; startBreak(7); }
    }
    function startBreak(mins) {
        state.isBreak = true; state.seconds = mins*60;
        document.getElementById('break-overlay').style.display = 'flex';
        setGame('snake');
    }
    function endBreak() {
        state.isBreak = false; state.seconds = state.focusTime * 60;
        document.getElementById('break-overlay').style.display = 'none';
        clearInterval(state.gameInterval);
    }

    // --- LOCKOUT ---
    function triggerLockout() {
        const overlay = document.getElementById('lockout-overlay');
        overlay.classList.remove('hidden');
        overlay.style.display = 'flex';
        document.getElementById('lockout-q').innerText = "2 + 2 = ?";
    }
    function checkLockout(e) {
        if(e.key === 'Enter' && e.target.value === '4') {
            document.getElementById('lockout-overlay').classList.add('hidden');
            document.getElementById('lockout-overlay').style.display = 'none';
        }
    }

    // --- UTILS ---
    function toggleSettings() { document.getElementById('settings-overlay').classList.toggle('open'); }
    function requestPause() { 
        document.getElementById('pause-modal').classList.remove('hidden'); 
        document.getElementById('pause-modal').style.display = 'flex';
    }
    function confirmPause() {
        state.isPaused = true;
        const m = document.getElementById('pause-duration').value;
        document.getElementById('pause-modal').classList.add('hidden');
        document.getElementById('pause-modal').style.display = 'none';
        setTimeout(() => state.isPaused = false, m*60000);
    }
    function updateSpotify() {
        const url = document.getElementById('spotify-link-input').value;
        if(url) {
             const id = url.split('/').pop().split('?')[0];
             document.getElementById('spotify-frame').src = `https://open.spotify.com/embed/playlist/${id}`;
             document.getElementById('spotify-container').style.display = 'block';
        }
    }
    function newChat() {
        document.getElementById('chat-history').innerHTML = '<div class="chat-msg bot">Chat Cleared.</div>';
    }
    function handleAI(e) {
        if(e.key === 'Enter') {
            document.getElementById('chat-history').innerHTML += `<div class="chat-msg user">${e.target.value}</div>`;
            setTimeout(() => {
                document.getElementById('chat-history').innerHTML += `<div class="chat-msg bot">Processed: ${e.target.value}</div>`;
            }, 600);
            e.target.value = '';
        }
    }

</script>
</body>
</html>
